<?xml version="1.0" encoding="utf-8"?>
<!--
    Cron job para ejecutar batch close automático en Nuvei.

    Frecuencia: UNA VEZ POR DÍA
    - Se ejecuta diariamente a la hora configurada en nuvei.module.config.batch_close_hour
    - Ejemplo: 23.983 = 11:59 PM
    - Ejecuta batch close para TODAS las terminales Nuvei con auto batch close habilitado
    - Prevención de duplicados mediante nuvei_batch_close_last_date (no ejecuta si ya se hizo hoy)
-->
<odoo>
    <record id="ir_cron_nuvei_batch_close_auto" model="ir.cron">
        <field name="name">Nuvei - Automatic Batch Close (Daily)</field>
        <field name="model_id" ref="point_of_sale.model_pos_payment_method"/>
        <field name="state">code</field>
        <field name="code">env['pos.payment.method']._run_batch_close_auto_if_needed()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <!-- Se ejecuta una vez al día -->
    </record>
</odoo>
